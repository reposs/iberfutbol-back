# ============================================================================
# IBERFÚTBOL BACKEND CONFIGURATION
# ============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Persistence Mode: 'memory' (instant seeded data) | 'postgres' (TypeORM PostgreSQL)
PERSISTENCE_MODE=memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=futbol_user
POSTGRES_PASSWORD=futbol_secret
POSTGRES_DB=futbol_db

# Cache Mode: 'memory' | 'redis'
CACHE_MODE=memory
REDIS_HOST=localhost
REDIS_PORT=6379

# Football Data Provider: 'live-spanish' | 'realistic-spanish' | 'football-data' | 'api-football'
FOOTBALL_DATA_PROVIDER=live-spanish
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# AI Content Generator Provider: 'structured-fallback' | 'ollama' | 'gemini' | 'openai'
AI_PROVIDER=structured-fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
